# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aforsev_db?schema=public"

# Authentication
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_key_here_min_32_chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS="12"

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN="your_facebook_whatsapp_access_token"
WHATSAPP_VERIFY_TOKEN="your_webhook_verification_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"

# Stripe Payments (Optional for MVP)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Gmail SMTP)
# NOTE: For Gmail, you MUST use an App Password (not your regular password).
# Steps to create an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled
#   3. Go to "App passwords" (search in Google Account settings)
#   4. Select "Mail" and your device, then generate
#   5. Use the 16-character App Password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
FROM_EMAIL="your_email@gmail.com"
FROM_NAME="AFORSEV E-commerce"
ADMIN_EMAIL="admin@aforsev.com"

# Application
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"
SESSION_SECRET="your_session_secret_here_min_32_chars"

# Redis (Optional for caching)
REDIS_URL="redis://localhost:6379"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="info"